# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docuverify?schema=public"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Python Document Processor Service
DOC_PROCESSOR_URL="http://localhost:8000"

# LLM API 
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_EXTRACTION_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Backend & Frontend URLs
BACKEND_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api"